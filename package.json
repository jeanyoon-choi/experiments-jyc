{
  "name": "experiments",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#socket/c-val": "./apps/c-val/socket/experiments/index.mjs",
    "#socket/ddong-meong": "./apps/ddong-meong/socket/experiments/index.mjs",
    "#socket/goldfishes": "./apps/goldfishes/socket/experiments/index.mjs",
    "#socket/six-sigma": "./apps/six-sigma/socket/experiments/index.mjs",
    "#socket/scc": "./apps/scc/socket/experiments/index.mjs",
    "#socket/xyt-cube": "./apps/xyt-cube/socket/experiments/index.mjs"
  },
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev": "node scripts/dev-https.mjs --all",
    "dev:scc": "node scripts/dev-https.mjs --app scc",
    "dev:c-val": "node scripts/dev-https.mjs --app c-val",
    "dev:ddong-meong": "node scripts/dev-https.mjs --app ddong-meong",
    "dev:goldfishes": "node scripts/dev-https.mjs --app goldfishes",
    "dev:six-sigma": "node scripts/dev-https.mjs --app six-sigma",
    "dev:xyt-cube": "node scripts/dev-https.mjs --app xyt-cube",
    "dev:next": "node scripts/dev-https.mjs --all",
    "dev:socket": "bash scripts/generate-certs.sh && node socket-server.mjs",
    "dev:socket:scc": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=scc node socket-server.mjs",
    "dev:socket:c-val": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=c-val node socket-server.mjs",
    "dev:socket:ddong-meong": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=ddong-meong node socket-server.mjs",
    "dev:socket:goldfishes": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=goldfishes node socket-server.mjs",
    "dev:socket:six-sigma": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=six-sigma node socket-server.mjs",
    "dev:socket:xyt-cube": "bash scripts/generate-certs.sh && SCC_SOCKET_SCOPE=xyt-cube node socket-server.mjs",
    "socket:production": "node socket-server-production.mjs",
    "desktop-collage:helper": "bash scripts/generate-certs.sh && node apps/scc/components/desktop-collage/helper/serve.ts",
    "deploy:scc-relay": "node scripts/deploy-scc-relay.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint",
    "audit:goldfishes-assets": "pnpm --filter @scc/goldfishes audit:assets",
    "audio:c-val": "pnpm --filter @scc/c-val audio",
    "test:c-val:shake": "pnpm --filter @scc/c-val test:shake",
    "test:c-val:shake:v1": "pnpm --filter @scc/c-val test:shake:v1",
    "test:c-val:shake:v2": "pnpm --filter @scc/c-val test:shake:v2"
  },
  "dependencies": {
    "sharp": "0.34.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "next": "16.2.10",
    "typescript": "^5"
  }
}
